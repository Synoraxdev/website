{
  "name": "hozvikcloud-homepage",
  "version": "1.0.0",
  "description": "Static homepage for HozvikCloud",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
